{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chiendz11/iris-gitops/contracts/model-result-v1.schema.json",
  "title": "Iris training result contract v1",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"bootstrap_required": {"const": true}},
        "required": ["bootstrap_required"]
      },
      "then": {
        "properties": {
          "quality_gate_passed": {"const": true},
          "model_version": {"type": "string", "pattern": "^[0-9]+$"},
          "baseline_model_version": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "bootstrap_required": {"const": false},
          "quality_gate_passed": {"const": true},
          "model_version": {"type": "string"}
        },
        "required": ["bootstrap_required", "quality_gate_passed", "model_version"]
      },
      "then": {
        "properties": {
          "baseline_model_version": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        }
      }
    }
  ],
  "required": [
    "contract_version",
    "model_name",
    "model_version",
    "baseline_model_version",
    "quality_gate_passed",
    "bootstrap_required",
    "run_id",
    "dataset_version",
    "source_repository",
    "source_sha",
    "metrics"
  ],
  "properties": {
    "contract_version": {"const": "v1"},
    "model_name": {"const": "iris-classifier"},
    "model_version": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9]+$"},
        {"type": "null"}
      ]
    },
    "baseline_model_version": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9]+$"},
        {"type": "null"}
      ]
    },
    "quality_gate_passed": {"type": "boolean"},
    "bootstrap_required": {"type": "boolean"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "dataset_version": {"type": "string", "minLength": 1, "maxLength": 200},
    "source_repository": {"const": "chiendz11/iris-data-pipeline"},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accuracy", "f1_macro", "baseline_accuracy"],
      "properties": {
        "accuracy": {"type": "number", "minimum": 0, "maximum": 1},
        "f1_macro": {"type": "number", "minimum": 0, "maximum": 1},
        "baseline_accuracy": {
          "oneOf": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
